# Copia este archivo a .env y rellena los valores reales.
# .env nunca se sube al repo (ver .gitignore).

# Entorno lógico de la app: dev | test | production (ver src/shared/infrastructure/container.ts)
# Si se omite, container.ts usa "dev" por defecto.
APP_ENV=dev

# Supabase (ADR-04, ADR-06). Obtenidos desde el proyecto de Supabase:
# Project Settings > API.
SUPABASE_URL=
# Service role key — solo se usa en api/ (servidor), nunca en el navegador.
SUPABASE_SERVICE_ROLE_KEY=

# URL pública de esta app (RF-38, recuperación de contraseña). En local:
# http://localhost:3000. En producción: la URL real de Vercel. Debe añadirse
# también en Supabase: Authentication > URL Configuration > Redirect URLs,
# como "<APP_URL>/restablecer-password".
APP_URL=http://localhost:3000

# Umbral de recomendaciones (RF-18): se propone una idea cuando una categoría
# puntúa POR DEBAJO de este valor (entero de 2 a 10). Opcional; por defecto 5
# (es decir, puntuaciones de 1 a 4). Un valor inválido se ignora y usa el 5.
# RECOMMENDATION_THRESHOLD=5

# Ideas personalizadas con IA (RF-40). Sin valor: función apagada y la opción no
# se ofrece (producción hasta RF-40b). "fake": escritor determinista, para
# desarrollo (npm run dev:local y los E2E ya lo ponen solos).
# AI_IDEAS_PROVIDER=fake
