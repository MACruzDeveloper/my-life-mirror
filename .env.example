# Copia este archivo a .env y rellena los valores reales.
# .env nunca se sube al repo (ver .gitignore).

# Entorno lógico de la app: dev | test | production (ver src/shared/infrastructure/container.ts)
# Si se omite, container.ts usa "dev" por defecto.
APP_ENV=dev

# MongoDB Atlas (ADR-04). Obtenidos desde el proyecto de Atlas:
# Database Access (usuario/contraseña) y Database > Connect > Drivers (URI).
MONGODB_USERNAME=
MONGODB_PASSWORD=
MONGODB_URI=
