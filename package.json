{
  "name": "my-life-mirror",
  "private": true,
  "license": "UNLICENSED",
  "version": "1.4.1",
  "type": "module",
  "imports": {
    "#shared/*": "./src/shared/*",
    "#modules/*": "./src/modules/*"
  },
  "scripts": {
    "dev": "vite --open",
    "dev:full": "(sleep 2 && open http://localhost:3000) & npx -y vercel dev",
    "dev:local": "node scripts/dev-local.mjs",
    "demo:reset": "node scripts/demo-reset.mjs",
    "backup:db": "node scripts/backup-db.mjs",
    "audit": "npm audit --audit-level=high",
    "build": "tsc -b && vite build",
    "check:api": "node scripts/check-api-types.mjs",
    "lint": "eslint .",
    "typecheck": "tsc -b",
    "preview": "vite preview",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "eval:ai": "RUN_AI_EVAL=1 node --env-file=.env ./node_modules/vitest/vitest.mjs run tests/eval",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:api": "node scripts/e2e-api.mjs",
    "smoke:prod": "node scripts/smoke-prod.mjs",
    "prepare": "husky",
    "verify": "npm run lint && npm run test:coverage && npm run build && npm run check:api && npm run test:e2e"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^9.4.0",
    "@mui/material": "^9.4.0",
    "@supabase/supabase-js": "^2.117.3",
    "@tanstack/react-query": "^5.104.1",
    "echarts": "^6.1.0",
    "i18next": "^26.4.2",
    "leaflet": "^1.9.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-i18next": "^17.0.16",
    "react-router": "^7.18.3",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^24.13.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/topojson-client": "^3.1.5",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "jsdom": "^30.1.3",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.4",
    "vitest": "^5.0.0"
  }
}
